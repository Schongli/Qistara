{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qistara",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libmpv2"
        ]
      }
    }
  }
}
