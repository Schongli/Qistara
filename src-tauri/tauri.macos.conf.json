{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qistara",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "files": {
        "MacOS/lib/libmpv-wrapper.dylib": "lib/libmpv-wrapper.dylib",
        "MacOS/lib/libmpv.dylib": "lib/libmpv.dylib"
      }
    }
  }
}
