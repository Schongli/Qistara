{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Permissions on phones (Tauri mobile): no libmpv or window controls there",
  "windows": [
    "main"
  ],
  "platforms": [
    "android",
    "iOS"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://musicbrainz.org/*"
        },
        {
          "url": "https://coverartarchive.org/*"
        },
        {
          "url": "https://*.archive.org/*"
        },
        {
          "url": "https://*.api.radio-browser.info/*"
        }
      ]
    }
  ]
}
